<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
     GeoTrack permissions are disabled with the service for now.
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    -->
    <application
        android:name=".NuntiusApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nuntius">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nuntius"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Nuntius"
            android:windowSoftInputMode="adjustResize" />
        <!--
        GeoTrack is disabled for now.
        <service
            android:name=".GeoTrack"
            android:foregroundServiceType="location"
            android:exported="false" />
        -->
        <activity
            android:name=".AuthenticatedApp"
            android:exported="false"
            android:theme="@style/Theme.Nuntius"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
